{
  "name": "dsh-grill-level",
  "version": "0.1.0",
  "description": "Per-session grill-me clarification intensity (off/low/medium/high/full) with a /grill command, a + menu picker, a session projection, and a prompt-policy section.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/policy.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "skill"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "grill-me",
    "clarification"
  ],
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-commands"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.1-rc.1"
  }
}
